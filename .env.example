# Copy to .env and fill from your password manager. Never commit .env.

# Infer + rank (Grok 4.6 at https://api.x.ai/v1). Password manager: xAI API key.
XAI_API_KEY=

# SAM Assistance Listings join-only cache, plus optional Contract Opportunities
# retrieve (sam_opps). Password manager: SAM.gov public API key.
# No-Role cap is 10 req/day. Fail soft if the cap is hit.
SAM_API_KEY=

# Leftover surfaces (Playbook directory, resources, startups). Optional.
# If unset, the app reads data/catalog/*.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Utah startups map tiles. Public token only (pk.). Optional.
# If unset, /startups still shows the schematic plot and the company list.
NEXT_PUBLIC_MAPBOX_TOKEN=
